# Database Configuration (Supabase/PostgreSQL)
# Hỗ trợ cả 2 naming convention (lowercase & uppercase) cho compatibility
user=your_db_user_here
password=your_db_password_here
host=your_db_host_here
port=5432
dbname=postgres

# Standardized DB Environment Variables
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_HOST=your_db_host_here
DB_PORT=5432
DB_NAME=postgres

# Security & Authentication
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Email Service (Gmail SMTP)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# Application Config
PORT_APP=8000
ALLOWED_ORIGINS=http://localhost:4200,https://your-vercel-app.vercel.app

# AI Service (ShopAIKey / OpenAI)
SHOPAIKEY_API_KEY=sk-your_api_key_here

# Simulation Config (Optional - for backend internal simulation)
ENABLE_INTERNAL_SIMULATION=false
